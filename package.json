{
  "name": "artinarey",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test 'packages/*/src/*.test.ts' 'apps/gui/src/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "lint": "eslint packages apps/gui/src",
    "build": "tsc --noEmit -p tsconfig.json --pretty false",
    "build:gui": "pnpm --filter artinarey-gui exec vite build",
    "test:gui": "cargo test --manifest-path apps/gui/src-tauri/Cargo.toml",
    "audit": "pnpm audit --audit-level=high",
    "test:ci": "node --import tsx --test 'packages/*/src/*.test.ts' 'apps/gui/src/*.test.ts' && node --test .github/scripts/*.test.cjs",
    "version:check": "node .github/scripts/app-version.cjs agree"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "packageManager": "pnpm@10.34.9"
}
